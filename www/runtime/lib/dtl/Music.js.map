root:load_mml_mod=[
    [root:mml_mod] ! then [] else [
        root:autio_ctx=(window:AudioContext) ! new.
        url=(window:runtimePath)+"lib/mml.js".
        root:mml_mod=root ! (url) import.
    ] execute.
    root:mml_mod.
].
playable=!create.
playable:tempo=[|t|
    _tempo=t. self.
].
musicMelody=playable !create.

Melody=musicMelody.
Instrument=!create.
Instrument:resolve=[|p| 
    window:Promise ! (p) resolve.
].
Instrument:fetch=[|url;r|
    // fetch instanceof Promise is false...
    r=! (window!(url) fetch) resolve.
    ! (r ! arrayBuffer) resolve.
].
Instrument:initialize=[|name|
    url=name.
].
Instrument:load=[|;r a mod|
    [waveform] ! then [waveform] else [
        a=!(url) fetch.
        mod=root! load_mml_mod.
        waveform=!(
        mod:oscillator! (root:autio_ctx) (a) bufferedWaveformOfFile)
        resolve.
    ] execute.
].
musicMelody:set=[|instrument|
    waveform=instrument ! load.
].
musicMelody:initialize=[
    queue=Array ! create.   
    //(window:console)! "Q" (self) log.
    waveform="square".    
    _tempo=88.
].
musicMelody:single=[|mml; mod p|
    mod=root! load_mml_mod.
    p= mod:MelodyParser ! (mod:japaneseLiteralSet) (mml) new.
    melody=p ! parse.
    melody.
    //(window:console)! (melody) log.
].
musicMelody:add=[|mml; melody|
    [mml:queue] ! then [
        (mml:queue) ! [|m| queue ! (m) add] each.
        //(window:console)! "Q1" (melody) (queue) log.
        
    ] else [
        //(window:console)! "Q2" (self) log.
        melody=! (mml) single.
        //(window:console)! "Q2" (melody) (queue) log.
        queue= queue ! (melody) concat.
    ] execute .
    self.
].
musicMelody:silent=[|c;str|
    str="".
    [str=str+"・"] !(c) repeat.
    ! (str) add.
    self.
].
musicMelody:play=[|;mod src|
    mod=root! load_mml_mod.
    src=mod ! (queue) (_tempo) (waveform) toSource.
    playback=src! (root:autio_ctx) play.
].
musicBand=playable ! create.
Band=musicBand.
musicBand:initialize=[
    members=Array ! create.
    arguments ! [|m| !(m) add ] each.
    _tempo=88.
].
musicBand:add=[|m|
    members ! (m) add.
    self.
].
musicBand:tempo=[|t|
    members ! [|m| m! (t) tempo.] each.
].
musicBand:play=[
    members ! [|m| m! play.] each.
].



